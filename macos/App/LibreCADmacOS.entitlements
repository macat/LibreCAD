<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  LibreCADmacOS.entitlements — hardened-runtime entitlements for the
  Developer ID signed / notarized build (GPLv2-or-later).

  These are applied ONLY by the Developer ID signing path
  (macos/scripts/sign-and-notarize.sh). The default ad-hoc build in
  make-app.sh does NOT use them. Notarization requires the hardened
  runtime (codesign --options runtime); this file declares the few
  relaxations the app needs under that runtime.

  Intentionally minimal — the app is not sandboxed (it is a developer
  tool distributed outside the Mac App Store via Developer ID). Add the
  com.apple.security.app-sandbox key + scoped file-access entitlements
  only if/when an App Store build is pursued.
-->
<plist version="1.0">
<dict>
	<!--
	  The Swift/SwiftUI toolchain may JIT-compile (e.g. Metal runtime shader
	  compilation, Swift runtime). Allow it so the hardened runtime does not
	  block execution. This is the standard relaxation for apps that build
	  Metal libraries from source at runtime (see CONVENTIONS.md: runtime-
	  compiled Metal shaders).
	-->
	<key>com.apple.security.cs.allow-jit</key>
	<true/>

	<!--
	  Allow loading of unsigned / ad-hoc-signed dynamic libraries pulled in by
	  the SwiftPM toolchain. Conservative inclusion so notarization does not
	  fail on toolchain-provided dylibs that are not Developer ID signed.
	-->
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
</dict>
</plist>
